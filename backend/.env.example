# Database Configuration
# Using SQLite for development, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./todo.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/todo_db

# Authentication Configuration
# Generate a secure secret key for JWT token signing
JWT_SECRET=your-very-long-secret-key-here-should-be-at-least-32-characters-long

# Application Environment
ENVIRONMENT=development

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Configuration (comma-separated origins for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000